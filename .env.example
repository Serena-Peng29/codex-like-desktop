# Deployed new-api gateway; the desktop logs in with gateway accounts and
# provisions each user's own relay key automatically. Required for login.
NEWAPI_BASE_URL=https://new-api.example.com
# Top-up page opened by the in-app recharge button (defaults to
# {NEWAPI_BASE_URL}/console/topup).
# NEWAPI_TOPUP_URL=
# Quota units per US dollar served by the gateway (new-api default: 500000).
# NEWAPI_QUOTA_PER_UNIT=500000
# Name of the per-user relay key auto-created on first login.
# NEWAPI_TOKEN_NAME=codex-harness
# Last-resort model when neither WAY2AGI_MODEL nor the gateway catalog applies.
# NEWAPI_DEFAULT_MODEL=gpt-5.6-sol

# Dev escape hatch: provide gateway URL + token to skip the desktop login gate.
# WAY2AGI_GATEWAY_URL=
# WAY2AGI_GATEWAY_TOKEN=
# WAY2AGI_MODEL=
