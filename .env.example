# Deployed new-api gateway (default https://pevo.ai); the desktop logs in with
# gateway accounts and provisions each user's own relay key automatically.
# PEVO_BASE_URL=https://pevo.ai
# PEVO_TOPUP_URL=https://pevo.ai/console/topup
# Quota units per US dollar served by the gateway (pevo.ai: 500000).
# PEVO_QUOTA_PER_UNIT=500000

# Dev escape hatch: provide gateway URL + token to skip the desktop login gate.
# WAY2AGI_GATEWAY_URL=
# WAY2AGI_GATEWAY_TOKEN=
# WAY2AGI_MODEL=

# Never commit real provider keys.
OPENAI_API_KEY=

# Optional React Bits Pro registry key for installing premium UI blocks locally.
# Keep this out of source control and never bundle it into the desktop app.
REACTBITS_LICENSE_KEY=

# Billing and payment placeholders
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
ALIPAY_APP_ID=
