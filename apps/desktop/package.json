{
  "name": "@codex-like/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts"
  },
  "build": {
    "appId": "com.way2agi.code",
    "productName": "Codex Harness",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "sidecar"
      },
      {
        "from": "bundled-skills",
        "to": "bundled-skills",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/.git/**",
          "!**/node_modules/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.log"
        ]
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
