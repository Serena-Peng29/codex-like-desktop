{
  "name": "codex-like-desktop",
  "private": true,
  "workspaces": ["apps/desktop", "services/api", "services/model-gateway", "services/billing", "packages/protocol", "packages/shared"],
  "scripts": {
    "dev": "npm run build:all && electron apps/desktop/dist/main.js",
    "build:all": "tsc -p packages/shared/tsconfig.json && tsc -p packages/protocol/tsconfig.json && tsc -p services/billing/tsconfig.json && tsc -p services/model-gateway/tsconfig.json && tsc -p services/api/tsconfig.json && tsc -p apps/desktop/tsconfig.json && npm run build --workspace @codex-like/desktop",
    "test": "vitest run",
    "typecheck": "npm run build:all",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "startup-check": "npm run build:all && node scripts/startup-check.mjs",
    "protocol-smoke": "node scripts/app-server-protocol-smoke.mjs",
    "protocol-schema-check": "node scripts/protocol-schema-check.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^31.0.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vitest": "^2.0.5"
  }
}
